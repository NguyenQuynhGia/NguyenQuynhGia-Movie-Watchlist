{
  "expo": {
    "name": "Movie Watchlist",
    "slug": "movie-watchlist",
    "version": "1.0.0",
    "scheme": "moviewatchlist",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://github.com/expo/router"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
